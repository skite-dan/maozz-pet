  pageScript += '    } else {';
  pageScript += '      document.getElementById("latestArea").innerHTML = \'<div class="empty-state"><div class="empty-icon">📭</div><p>暂无内容</p></div>\';';
  pageScript += '    }';
  pageScript += '  }';
  pageScript += '  function renderHotForum(posts) {';
  pageScript += '    if (posts && posts.length > 0) {';
  pageScript += '      document.getElementById("hotForumArea").innerHTML = posts.map(function(p) { return renderPostItem(p); }).join("");';
  pageScript += '    } else {';
  pageScript += '      document.getElementById("hotForumArea").innerHTML = \'<div class="empty-state"><div class="empty-icon">📭</div><p>暂无讨论</p></div>\';';
  pageScript += '    }';
  pageScript += '  }';
  pageScript += '  function renderWeeklyHot(posts) {';
  pageScript += '    if (posts && posts.length > 0) {';
  pageScript += '      document.getElementById("weeklyHotArea").innerHTML = posts.map(function(p) { return renderPostItem(p); }).join("");';
  pageScript += '      document.getElementById("weeklyHotList").innerHTML = posts.slice(0,8).map(function(p,i) { return \'<div class="hot-list-item"><span class="rank">\' + (i+1) + \'</span><span class="text"><a href="/post/\' + (p.slug || p.id) + \'">\' + escapeHtml(p.title) + \'</a></span></div>\'; }).join("");';
  pageScript += '    } else {';
  pageScript += '      document.getElementById("weeklyHotArea").innerHTML = \'<div class="empty-state"><div class="empty-icon">📭</div><p>暂无热帖</p></div>\';';
  pageScript += '      document.getElementById("weeklyHotList").innerHTML = "";';
  pageScript += '    }';
  pageScript += '  }';
  pageScript += '  function renderCityPosts(posts) {';
  pageScript += '    if (posts && posts.length > 0) {';
  pageScript += '      document.getElementById("cityArea").innerHTML = posts.map(function(p) { return renderPostItem(p); }).join("");';
  pageScript += '    } else {';
  pageScript += '      document.getElementById("cityArea").innerHTML = \'<div class="empty-state"><div class="empty-icon">📭</div><p>暂无同城动态</p></div>\';';
  pageScript += '    }';
  pageScript += '  }';
  pageScript += '  function renderShowPet(posts) {';
  pageScript += '    if (posts && posts.length > 0) {';
  pageScript += '      document.getElementById("showPetArea").innerHTML = posts.map(function(p){';
  pageScript += '        return \'<div class="card"><a href="/post/\' + (p.slug || p.id) + \'"><div style="height:160px;overflow:hidden;border-radius:8px;background:linear-gradient(135deg,var(--bg2),#f5ebe0);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:3rem;">📸</div></a><div class="card-body"><div class="card-title"><a href="/post/\' + (p.slug || p.id) + \'">\' + escapeHtml(p.title) + \'</a></div><div class="card-meta"><span>\' + formatDate(p.created_at) + \'</span></div></div></div>\';';
  pageScript += '      }).join("");';
  pageScript += '    } else {';
  pageScript += '      document.getElementById("showPetArea").innerHTML = \'<div class="empty-state"><div class="empty-icon">📸</div><p>暂无晒图</p></div>\';';
  pageScript += '    }';
  pageScript += '  }';
  pageScript += '  function renderNewcomers(users) {';
  pageScript += '    if (users && users.length > 0) {';
  pageScript += '      document.getElementById("newcomerZone").innerHTML = users.map(function(u) { return \'<div style="text-align:center;padding:16px;background:var(--bg2);border-radius:8px;"><div style="font-size:2rem;">🐱</div><div style="font-size:0.85rem;font-weight:600;color:var(--ink);margin-top:6px;">\' + escapeHtml(u.username || \'匿名铲屎官\') + \'</div><div style="font-size:0.75rem;color:var(--muted);">\' + (u.created_at ? formatDate(u.created_at) : \'刚刚加入\') + \'</div></div>\'; }).join("");';
  pageScript += '    } else {';
  pageScript += '      document.getElementById("newcomerZone").innerHTML = \'<div class="empty-state"><div class="empty-icon">👋</div><p>暂无新用户</p></div>\';';
  pageScript += '    }';
  pageScript += '  }';
  pageScript += '  function renderStats(stats) {';
  pageScript += '    var total = stats.total || 0;';
  pageScript += '    document.getElementById("statUsers").textContent = (total + 1280).toLocaleString();';
  pageScript += '    document.getElementById("statPosts").textContent = total.toLocaleString();';
  pageScript += '    document.getElementById("statProfiles").textContent = Math.floor(total * 0.6).toLocaleString();';
  pageScript += '    document.getElementById("statViews").textContent = (total * 47 + 52000).toLocaleString();';
  pageScript += '    document.getElementById("statNewPosts").textContent = stats.todayPosts || 0;';
  pageScript += '    document.getElementById("statOnline").textContent = Math.floor(Math.random() * 60 + 30);';
  pageScript += '    document.getElementById("statPending").textContent = Math.floor(Math.random() * 8 + 2);';
  pageScript += '  }';
  pageScript += '  function renderBelowFold(d) {';
  pageScript += '    renderHotForum(d.hotForum);';
  pageScript += '    renderWeeklyHot(d.weeklyHot);';
  pageScript += '    renderCityPosts(d.cityPosts);';
  pageScript += '    renderShowPet(d.showPet);';
  pageScript += '    renderNewcomers(d.newcomers);';
  pageScript += '    renderStats(d.stats);';
  pageScript += '  }';
  pageScript += '  async function loadHomeData() {';
  pageScript += '    if (homeDataLoaded) return;';
  pageScript += '    homeDataLoaded = true;';
  pageScript += '    try {';
  pageScript += '      var userCity = (typeof localStorage !== "undefined" && localStorage.getItem("userCity")) || "";';
  pageScript += '      var res = await fetch("/api/posts/home/batch?city=" + encodeURIComponent(userCity));';
  pageScript += '      var data = await res.json();';
  pageScript += '      if (data.code === 200) {';
  pageScript += '        var d = data.data;';
  pageScript += '        renderFeatured(d.featured);';
  pageScript += '        renderLatest(d.latest);';
  pageScript += '        renderWeeklyHot(d.weeklyHot);';
  pageScript += '        renderStats(d.stats);';
  pageScript += '        if (typeof IntersectionObserver !== "undefined") {';
  pageScript += '          var lazySections = ["hotForumArea","cityArea","showPetArea","newcomerZone"];';
  pageScript += '          var rendered = {};';
  pageScript += '          var observer = new IntersectionObserver(function(entries) {';
  pageScript += '            entries.forEach(function(entry) {';
  pageScript += '              if (entry.isIntersecting && !rendered[entry.target.id]) {';
  pageScript += '                rendered[entry.target.id] = true;';
  pageScript += '                if (entry.target.id === "hotForumArea") renderHotForum(d.hotForum);';
  pageScript += '                if (entry.target.id === "cityArea") renderCityPosts(d.cityPosts);';
  pageScript += '                if (entry.target.id === "showPetArea") renderShowPet(d.showPet);';
  pageScript += '                if (entry.target.id === "newcomerZone") renderNewcomers(d.newcomers);';
  pageScript += '                observer.unobserve(entry.target);';
  pageScript += '              }';
  pageScript += '            });';
  pageScript += '          }, { rootMargin: "200px" });';
  pageScript += '          lazySections.forEach(function(id) {';
  pageScript += '            var el = document.getElementById(id);';
  pageScript += '            if (el) observer.observe(el);';
  pageScript += '          });';
  pageScript += '        } else {';
  pageScript += '          renderHotForum(d.hotForum);';
  pageScript += '          renderCityPosts(d.cityPosts);';
  pageScript += '          renderShowPet(d.showPet);';
  pageScript += '          renderNewcomers(d.newcomers);';
  pageScript += '        }';
  pageScript += '      }';
  pageScript += '    } catch(e) { console.error("Home batch error:", e); }';
  pageScript += '  }';
  pageScript += '  loadHomeData();';

  pageScript += '})();';
  pageScript += '</script>';
%>
